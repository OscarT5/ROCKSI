  "item": [
    {
      "name": "Get ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"ID is UR1000\", function() {",
              "    pm.expect(pm.response.json().idUsuariorecep).to.eql(\"UR1000\");",
              "});",
              "",
              "pm.test(\"Name is Farita\", function() {",
              "    pm.expect(pm.response.json().nombreCompleto).to.eql(\"Farita\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
