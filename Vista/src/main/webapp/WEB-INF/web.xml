<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:h="http://xmlns.jcp.org/jsf/html"
      xmlns:p="http://primefaces.org/ui"
      xmlns:f="http://xmlns.jcp.org/jsf/core">

    <h:head>
        <title>Prueba de Alta Producto</title>
        <meta charset="UTF-8"/>
        <style>
            body {
            background-color: #f8f9fb;
            font-family: "Poppins", Arial, sans-serif;
            }

            /* Estilo modal */
            .ui-dialog {
            background: white !important;
            border-radius: 15px !important;
            border: none !important;
            }

            .ui-dialog-titlebar {
            background: white !important;
            border: none !important;
            text-align: center !important;
            box-shadow: none !important;
            }

            .ui-dialog-title {
            font-size: 24px !important;
            font-weight: 700 !important;
            color: #000 !important;
            }

            .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 15px;
            width: 90%;
            margin-left: auto;
            margin-right: auto;
            }

            .form-group label {
            margin-bottom: 5px;
            font-size: 14px;
            color: #555;
            }

            .form-control {
            border: none !important;
            border-bottom: 2px solid #ccc !important;
            border-radius: 0 !important;
            background: transparent !important;
            color: #000 !important;
            font-size: 15px !important;
            box-shadow: none !important;
            }

            .form-control:focus {
            border-color: #007bcb !important;
            outline: none !important;
            }

            .boton-registrar {
            border: none !important;
            border-radius: 8px !important;
            padding: 10px 16px !important;
            font-weight: 600 !important;
            font-size: 15px !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin: 15px auto 0 auto !important;
            width: 80% !important;
            background: #007bcb !important;
            color: #fff !important;
            }
        </style>
    </h:head>

    <h:body>

        <!--Boton de prueba-->
        <h:form>
            <p:commandButton value="Abrir"
                             icon="pi pi-plus"
                             onclick="PF('dlgAgregarProducto').show();" type="button"/>
        </h:form>

        <!--Modal de alta-->
        <p:dialog header="Nuevo producto"
                  widgetVar="dlgAgregarProducto"
                  modal="true" resizable="false"
                  closable="true" draggable="false"
                  width="360">

            <h:form id="formAltaProducto">
                <p:messages id="msgsAltaProducto" showDetail="true" closable="true"/>

                <div class="form-group">
                    <h:outputLabel for="nombreProducto" value="Nombre"/>
                    <p:inputText id="nombreProducto"
                                 value="#{altaProdBeanUI.nombre}"
                                 placeholder="Nombre"
                                 styleClass="form-control"
                                 required="true"
                                 requiredMessage="El campo Nombre es obligatorio"/>
                </div>

                <div class="form-group">
                    <h:outputLabel for="stockProducto" value="Stock"/>
                    <p:inputText id="stockProducto"
                                 value="#{altaProdBeanUI.stock}"
                                 placeholder="Existencia del producto"
                                 styleClass="form-control"
                                 required="true"
                                 requiredMessage="El campo Stock es obligatorio">
                        <f:validateLongRange minimum="1"/>
                    </p:inputText>
                </div>

                <div class="form-group">
                    <h:outputLabel for="precioProducto" value="Precio"/>
                    <p:inputText id="precioProducto"
                                 value="#{altaProdBeanUI.precio}"
                                 placeholder="Precio del producto"
                                 styleClass="form-control"
                                 required="true"
                                 requiredMessage="El campo Precio es obligatorio">
                        <f:validateDoubleRange minimum="0.01"/>
                    </p:inputText>
                </div>

                <div class="boton-registrar">
                    <p:commandButton id="registrarProductoBtn"
                                     value="Registrar el producto"
                                     icon="pi pi-plus-circle"
                                     action="#{altaProdBeanUI.altaProducto}"
                                     process="@form"
                                     update="msgsAltaProducto"
                                     styleClass="btn"/>
                </div>
            </h:form>
        </p:dialog>

    </h:body>
</html>
